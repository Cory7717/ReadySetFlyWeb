{
  "expo": {
    "name": "Ready Set Fly",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/RSFOpaqueLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/RSFOpaqueLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Ready Set Fly connects to nearby ADS-B receivers to show live traffic.",
        "NSLocationWhenInUseUsageDescription": "Ready Set Fly uses your location to show live flight stats and nearby airports.",
        "NSBonjourServices": [
          "_gdl90._udp"
        ]
      }
    },
    "android": {
      "package": "com.readysetfly.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/RSFOpaqueLogo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "$GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "readysetfly",
    "extra": {
      "eas": {
        "projectId": "ba4313c5-ab2d-4896-8125-68b2e54d88af"
      }
    },
    "owner": "carmer7717-2",
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
